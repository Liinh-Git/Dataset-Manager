# Dataset Manager Configuration
HOST=0.0.0.0
PORT=9200
STORE_DIR=var/datasets
TEMP_DIR=var/datasets-tmp
LOG_LEVEL=INFO

# Used only when DATASET_STORAGE_BACKEND=local to advertise Dataset Manager's
# own /artifacts/v1 routes (for example http://127.0.0.1:9200).
PUBLIC_BASE_URL=http://127.0.0.1:9200

# Storage Backend: "local" (default) or "huggingface"
DATASET_STORAGE_BACKEND=local

# Hugging Face Storage Backend Configuration (required if DATASET_STORAGE_BACKEND=huggingface)
# HF_REPO_ID=your-org-or-username/dataset-artifacts
# HF_TOKEN=hf_yourWriteAccessTokenHere
# HF_BRANCH=main
